---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const sheets = await getCollection('cheatsheets');
  return sheets.map((s) => ({ params: { id: s.id }, props: { sheet: s } }));
}

const { sheet } = Astro.props;
const { Content } = await render(sheet);
const d = sheet.data;
const lessons = await getCollection('lessons');
const related = (d.relatedLessons ?? [])
  .map((id: string) => lessons.find((l) => l.id === id))
  .filter((l): l is NonNullable<typeof l> => Boolean(l));
const reviewed = d.lastReviewed.toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  timeZone: 'UTC',
});
---

<BaseLayout title={`Cheat sheet: ${d.title}`} description={d.description}>
  <article class="cheatsheet mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="no-print flex flex-wrap items-center justify-between gap-3">
      <a href={url('/cheatsheets/')} class="text-xs text-[var(--color-accent)] hover:underline">
        ← Todas las cheat sheets
      </a>
      <button
        type="button"
        id="print-sheet"
        class="rounded-md border border-[var(--color-border)] bg-[var(--color-bg-raised)] px-3 py-1.5 text-sm text-[var(--color-text)] hover:border-[var(--color-accent)]"
      >
        Imprimir o guardar en PDF
      </button>
    </div>
    <h1 class="mt-3 text-3xl font-bold text-[var(--color-text)]">{d.title}</h1>
    <p class="mt-1 text-sm text-[var(--color-text-muted)]">{d.description}</p>
    <p class="mt-1 text-xs text-[var(--color-text-muted)]">Revisada en {reviewed}</p>

    <div class="prose prose-neutral dark:prose-invert mt-6 max-w-none">
      <Content />
    </div>

    {related.length > 0 && (
      <p class="no-print mt-8 text-sm text-[var(--color-text-muted)]">
        Para profundizar:{' '}
        {related.map((l, i) => (
          <>
            {i > 0 && ', '}
            <a
              class="text-[var(--color-accent)] hover:underline"
              href={url(`/teoria/${l.data.module}/${l.id.split('/').pop()}/`)}
            >
              {l.data.title}
            </a>
          </>
        ))}
      </p>
    )}
  </article>
</BaseLayout>

<style is:global>
  @media print {
    header,
    footer,
    nav,
    .no-print {
      display: none !important;
    }
    body {
      background: #fff !important;
      color: #000 !important;
    }
    .cheatsheet {
      max-width: none;
      padding: 0;
      font-size: 10pt;
    }
    .cheatsheet h1 {
      font-size: 18pt;
    }
    .cheatsheet h2 {
      font-size: 13pt;
      margin-top: 0.9em;
      break-after: avoid;
    }
    .cheatsheet table,
    .cheatsheet pre {
      break-inside: avoid;
      font-size: 8.5pt;
    }
    .cheatsheet * {
      color: #000 !important;
      background: transparent !important;
    }
  }
</style>

<script>
  document.getElementById('print-sheet')?.addEventListener('click', () => window.print());
</script>
