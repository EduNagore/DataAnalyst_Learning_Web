---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { url } from '../../../lib/url';

export async function getStaticPaths() {
  const cases = await getCollection('interviewCases');
  return cases.map((c) => ({ params: { caso: c.id }, props: { entry: c } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<BaseLayout title={`Caso de entrevista: ${d.title}`} description={d.description}>
  <article class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:px-8">
    <a href={url('/entrevistas/#casos')} class="text-xs text-[var(--color-accent)] hover:underline">
      ← Todos los casos de entrevista
    </a>
    <h1 class="mt-2 text-3xl font-bold text-[var(--color-text)]">{d.title}</h1>
    <p class="mt-2 text-sm text-[var(--color-text-muted)]">
      {d.estimatedMinutes} min · {d.description}
    </p>

    <p class="mt-6 rounded-md border-l-4 border-[var(--color-accent)] bg-[var(--color-bg-subtle)] p-3 text-sm text-[var(--color-text-muted)]">
      Resuelve primero por tu cuenta: escribe tus preguntas de aclaración y tu marco de respuesta
      antes de abrir cada sección.
    </p>

    <section class="mt-8">
      <h2 class="text-xl font-semibold text-[var(--color-text)]">Preguntas de aclaración</h2>
      <details class="mt-2 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-raised)] p-4">
        <summary class="cursor-pointer text-sm font-medium text-[var(--color-text)]">
          Ver las preguntas que conviene hacer
        </summary>
        <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-[var(--color-text)]">
          {d.clarifyingQuestions.map((q: string) => (
            <li>{q}</li>
          ))}
        </ul>
      </details>
    </section>

    <div class="prose prose-neutral dark:prose-invert mt-8 max-w-none">
      <Content />
    </div>

    <section class="mt-8">
      <h2 class="text-xl font-semibold text-[var(--color-text)]">Errores típicos</h2>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-[var(--color-text)]">
        {d.commonMistakes.map((m: string) => (
          <li>{m}</li>
        ))}
      </ul>
    </section>

    <section class="mt-8">
      <h2 class="text-xl font-semibold text-[var(--color-text)]">Qué diría un sénior</h2>
      <p class="mt-2 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-4 text-sm text-[var(--color-text)]">
        {d.seniorTake}
      </p>
    </section>
  </article>
</BaseLayout>
