---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../lib/url';

const items = [
  {
    title: 'Tests por módulo',
    href: '/practica/tests/',
    text: 'Preguntas tipo test con explicación de cada respuesta. Aprobado con el 80 %.',
    ready: true,
  },
  {
    title: 'Modo examen',
    href: '/practica/examen/',
    text: 'Preguntas aleatorias, temporizador opcional e informe por módulo.',
    ready: true,
  },
  {
    title: 'Repaso espaciado',
    href: '/practica/repaso/',
    text: 'Repasa con el método Leitner lo que has fallado.',
    ready: true,
  },
  {
    title: 'Laboratorios',
    href: '/practica/labs/',
    text: 'SQL y Python que se corrigen solos en tu navegador.',
    ready: false,
  },
  {
    title: 'SQL Playground',
    href: '/practica/sql/',
    text: 'Consola SQL libre sobre el dataset Lumen.',
    ready: false,
  },
  {
    title: 'Casos de análisis',
    href: '/practica/casos/',
    text: 'Investigaciones guiadas como las de un trabajo real.',
    ready: false,
  },
  {
    title: 'Hojas de cálculo',
    href: '/practica/hojas-de-calculo/',
    text: 'Libros Excel descargables con autocomprobación.',
    ready: false,
  },
];
---

<BaseLayout
  title="Práctica"
  description="Tests, exámenes, repaso espaciado, laboratorios de SQL y Python, SQL Playground y casos de análisis guiados."
>
  <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
    <h1 class="text-3xl font-bold text-[var(--color-text)]">Práctica</h1>
    <p class="mt-2 text-[var(--color-text-muted)]">
      Leer no basta: la práctica es lo que fija lo aprendido. Todo se corrige en tu navegador.
    </p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {items.map((item) => (
        <a
          href={url(item.href)}
          class="rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-raised)] p-5 hover:border-[var(--color-accent)]"
        >
          <p class="font-semibold text-[var(--color-text)]">
            {item.title}
            {!item.ready && (
              <span class="ml-2 rounded-full bg-[var(--color-bg-subtle)] px-2 py-0.5 text-xs font-normal text-[var(--color-text-muted)]">
                Próximamente
              </span>
            )}
          </p>
          <p class="mt-1 text-sm text-[var(--color-text-muted)]">{item.text}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
