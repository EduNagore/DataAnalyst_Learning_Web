---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../lib/url';

const allModules = await getCollection('modules');

const parts = new Map<string, { title: string; order: number; modules: typeof allModules }>();
for (const mod of allModules) {
  const existing = parts.get(mod.data.part);
  if (existing) {
    existing.modules.push(mod);
  } else {
    parts.set(mod.data.part, { title: mod.data.part, order: mod.data.partOrder, modules: [mod] });
  }
}
const orderedParts = [...parts.values()].sort((a, b) => a.order - b.order);
for (const part of orderedParts) {
  part.modules.sort((a, b) => a.data.order - b.data.order);
}
---

<BaseLayout
  title="Teoría"
  description="Índice de partes y módulos del curso, de fundamentos a nivel senior, con el progreso de cada uno."
>
  <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
    <h1 class="text-3xl font-bold text-[var(--color-text)]">Teoría</h1>
    <p class="mt-2 text-[var(--color-text-muted)]">
      30 módulos en 8 partes, de fundamentos del oficio a IA aplicada al análisis.
    </p>

    {orderedParts.length === 0 ? (
      <div class="mt-10 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-8 text-center">
        <p class="font-medium text-[var(--color-text)]">
          El contenido todavía se está escribiendo.
        </p>
        <p class="mt-2 text-sm text-[var(--color-text-muted)]">
          Consulta <code>PLAN.md</code> para ver el temario completo (Fases 6-8 del plan de
          implementación).
        </p>
      </div>
    ) : (
      <div class="mt-10 space-y-10">
        {orderedParts.map((part) => (
          <div>
            <h2 class="text-xl font-semibold text-[var(--color-text)]">{part.title}</h2>
            <div class="mt-4 grid gap-4 sm:grid-cols-2">
              {part.modules.map((mod) => (
                <a
                  href={url(`/teoria/${mod.data.id}/`)}
                  class="rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-raised)] p-5 hover:border-[var(--color-accent)]"
                >
                  <h3 class="font-semibold text-[var(--color-text)]">{mod.data.title}</h3>
                  <p class="mt-1 text-sm text-[var(--color-text-muted)]">{mod.data.description}</p>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
