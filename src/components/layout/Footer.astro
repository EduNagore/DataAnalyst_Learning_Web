---
import { url } from '../../lib/url';

const links = [
  { label: 'Radar', href: url('/radar/') },
  { label: 'Glosario', href: url('/glosario/') },
  { label: 'Fuentes', href: url('/fuentes/') },
  { label: 'Novedades', href: url('/novedades/') },
];
---

<footer class="mt-24 border-t border-[var(--color-border)]">
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <p class="font-semibold text-[var(--color-text)]">Data Analyst Academy</p>
        <p class="mt-1 max-w-sm text-sm text-[var(--color-text-muted)]">
          Teoría, práctica autocorregida y proyectos reales para llegar a analista de datos senior.
          Contenido en español, gratuito y de código abierto.
        </p>
      </div>
      <nav class="flex flex-wrap gap-x-6 gap-y-2 text-sm" aria-label="Secundaria">
        {links.map((link) => (
          <a href={link.href} class="text-[var(--color-text-muted)] hover:text-[var(--color-text)]">
            {link.label}
          </a>
        ))}
      </nav>
    </div>
    <p class="mt-8 text-xs text-[var(--color-text-muted)]">
      Proyecto educativo de código abierto. El dataset "Lumen" usado en los ejercicios es ficticio.
    </p>
  </div>
</footer>
