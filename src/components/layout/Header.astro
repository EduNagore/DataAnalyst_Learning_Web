---
import { url } from '../../lib/url';
import ThemeToggle from './ThemeToggle.astro';

const navItems = [
  { label: 'Teoría', href: url('/teoria/') },
  { label: 'Práctica', href: url('/practica/') },
  { label: 'Proyectos', href: url('/proyectos/') },
  { label: 'Entrevistas', href: url('/entrevistas/') },
  { label: 'Datos', href: url('/datos/') },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-[var(--color-border)] bg-[var(--color-bg)]/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-7xl items-center gap-4 px-4 sm:px-6 lg:px-8">
    <a href={url('/')} class="flex items-center gap-2 font-semibold text-[var(--color-text)]">
      <span class="inline-flex size-8 items-center justify-center rounded-md bg-[var(--color-accent)] text-sm font-bold text-[var(--color-accent-contrast)]">
        DA
      </span>
      <span class="hidden sm:inline">Data Analyst Academy</span>
    </a>

    <nav class="ml-4 hidden flex-1 items-center gap-1 text-sm md:flex" aria-label="Principal">
      {navItems.map((item) => {
        const active = currentPath.startsWith(item.href);
        return (
          <a
            href={item.href}
            aria-current={active ? 'page' : undefined}
            class:list={[
              'rounded-md px-3 py-2 font-medium transition-colors',
              active
                ? 'text-[var(--color-accent)]'
                : 'text-[var(--color-text-muted)] hover:text-[var(--color-text)]',
            ]}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <a
        href={url('/practica/sql/')}
        class="hidden rounded-md border border-[var(--color-border)] px-3 py-1.5 text-sm font-medium text-[var(--color-text-muted)] hover:text-[var(--color-text)] sm:inline-block"
      >
        Buscar
      </a>
      <a
        href={url('/progreso/')}
        class="hidden rounded-md px-3 py-1.5 text-sm font-medium text-[var(--color-text-muted)] hover:text-[var(--color-text)] sm:inline-block"
      >
        Progreso
      </a>
      <ThemeToggle />
      <button
        id="mobile-nav-toggle"
        type="button"
        aria-label="Abrir menú"
        aria-expanded="false"
        class="inline-flex size-9 items-center justify-center rounded-md border border-[var(--color-border)] text-[var(--color-text-muted)] md:hidden"
      >
        <svg
          aria-hidden="true"
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    class="hidden border-t border-[var(--color-border)] px-4 py-2 md:hidden"
    aria-label="Principal (móvil)"
  >
    {navItems.map((item) => (
      <a
        href={item.href}
        class="block rounded-md px-3 py-2 text-sm font-medium text-[var(--color-text-muted)] hover:text-[var(--color-text)]"
      >
        {item.label}
      </a>
    ))}
    <a
      href={url('/progreso/')}
      class="block rounded-md px-3 py-2 text-sm font-medium text-[var(--color-text-muted)] hover:text-[var(--color-text)]"
    >
      Progreso
    </a>
  </nav>
</header>

<script>
  const toggle = document.getElementById('mobile-nav-toggle');
  const nav = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const isHidden = nav?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', isHidden ? 'false' : 'true');
  });
</script>
