---
// Para afirmaciones sobre herramientas/versiones/precios vigentes (ver
// docs/CONTENT_GUIDELINES.md §4): obliga a fechar la afirmación.
interface Props {
  /** Formato "AAAA-MM". */
  date: string;
}
const { date } = Astro.props;
const [year, month] = date.split('-');
const formatted = new Date(Number(year), Number(month) - 1, 1).toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
});
---

<div class="my-5 rounded-md border border-dashed border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-4 text-sm">
  <p class="mb-1 font-mono text-xs font-semibold text-[var(--color-text-muted)]">
    A fecha de {formatted}
  </p>
  <div class="text-[var(--color-text)]">
    <slot />
  </div>
</div>
