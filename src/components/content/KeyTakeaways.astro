---
interface Props {
  items: string[];
}
const { items } = Astro.props;
---

<aside class="my-6 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-5">
  <h3 class="text-sm font-semibold tracking-wide text-[var(--color-text)] uppercase">
    Ideas clave
  </h3>
  <ul class="mt-3 list-inside list-disc space-y-1.5 text-sm text-[var(--color-text)]">
    {items.map((item) => (
      <li>{item}</li>
    ))}
  </ul>
</aside>
