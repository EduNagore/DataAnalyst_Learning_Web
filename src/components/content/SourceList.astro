---
interface Source {
  title: string;
  url: string;
  type: 'paper' | 'docs' | 'blog' | 'spec' | 'book' | 'video' | 'course';
  authors?: string;
  year: number;
}
interface Props {
  sources: Source[];
}
const { sources } = Astro.props;

const typeLabels: Record<Source['type'], string> = {
  paper: 'Paper',
  docs: 'Documentación',
  blog: 'Blog',
  spec: 'Especificación',
  book: 'Libro',
  video: 'Vídeo',
  course: 'Curso',
};
---

<section class="my-6">
  <h3 class="text-sm font-semibold tracking-wide text-[var(--color-text)] uppercase">Fuentes</h3>
  <ol class="mt-3 space-y-2 text-sm">
    {sources.map((source) => (
      <li class="text-[var(--color-text-muted)]">
        <a
          href={source.url}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[var(--color-accent)] hover:underline"
        >
          {source.title}
        </a>
        {source.authors && <> — {source.authors}</>} ({source.year}) ·{' '}
        <span class="text-xs">{typeLabels[source.type]}</span>
      </li>
    ))}
  </ol>
</section>
